      "signals": [
        {
          "type": "content",
          "path_glob": "**/Justfile",
          "regex": "(^|[;&|()\\s])gum\\s+(choose|confirm|file|filter|format|input|join|pager|spin|style|table|write|log|version-check)\\b",
          "case_sensitive": true
        },
        {
          "type": "content",
