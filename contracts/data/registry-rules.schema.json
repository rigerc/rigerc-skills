{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "registry-rules.schema.json",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": 1
    },
    "technologies": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512,
            "pattern": "^[a-z0-9][a-z0-9._/-]*$"
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          },
          "category": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          },
          "signals": {
            "type": "array",
            "items": {
              "oneOf": [
                {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "type": {
                      "const": "dependency"
                    },
                    "ecosystem": {
                      "enum": [
                        "npm",
                        "py",
                        "crate",
                        "go",
                        "composer",
                        "gem",
                        "hex"
                      ]
                    },
                    "name": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 256
                    }
                  },
                  "required": [
                    "type",
                    "ecosystem",
                    "name"
                  ]
                },
                {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "type": {
                      "const": "mcp_package"
                    },
                    "name": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 256
                    }
                  },
                  "required": [
                    "type",
                    "name"
                  ]
                },
                {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "type": {
                      "const": "path"
                    },
                    "path": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 512,
                      "pattern": "^(?!/)(?!.*(?:^|/)\\.{1,2}(?:/|$))(?!.*\\\\)(?!.*//)[A-Za-z0-9_.@/-]+$"
                    }
                  },
                  "required": [
                    "type",
                    "path"
                  ]
                },
                {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "type": {
                      "const": "glob"
                    },
                    "pattern": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 512
                    }
                  },
                  "required": [
                    "type",
                    "pattern"
                  ]
                },
                {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "type": {
                      "const": "extension"
                    },
                    "suffix": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 64,
                      "pattern": "^\\.[A-Za-z0-9._-]+$"
                    }
                  },
                  "required": [
                    "type",
                    "suffix"
                  ]
                },
                {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "type": {
                      "const": "content"
                    },
                    "path_glob": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 512
                    },
                    "regex": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 1024
                    },
                    "case_sensitive": {
                      "type": "boolean"
                    }
                  },
                  "required": [
                    "type",
                    "path_glob",
                    "regex"
                  ]
                }
              ]
            },
            "maxItems": 128,
            "minItems": 1,
            "uniqueItems": true
          }
        },
        "required": [
          "id",
          "name",
          "category",
          "signals"
        ]
      },
      "maxItems": 1024,
      "minItems": 0,
      "uniqueItems": true
    },
    "augmentations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "technology_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512,
            "pattern": "^[a-z0-9][a-z0-9._/-]*$"
          },
          "signals": {
            "type": "array",
            "items": {
              "oneOf": [
                {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "type": {
                      "const": "dependency"
                    },
                    "ecosystem": {
                      "enum": [
                        "npm",
                        "py",
                        "crate",
                        "go",
                        "composer",
                        "gem",
                        "hex"
                      ]
                    },
                    "name": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 256
                    }
                  },
                  "required": [
                    "type",
                    "ecosystem",
                    "name"
                  ]
                },
                {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "type": {
                      "const": "mcp_package"
                    },
                    "name": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 256
                    }
                  },
                  "required": [
                    "type",
                    "name"
                  ]
                },
                {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "type": {
                      "const": "path"
                    },
                    "path": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 512,
                      "pattern": "^(?!/)(?!.*(?:^|/)\\.{1,2}(?:/|$))(?!.*\\\\)(?!.*//)[A-Za-z0-9_.@/-]+$"
                    }
                  },
                  "required": [
                    "type",
                    "path"
                  ]
                },
                {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "type": {
                      "const": "glob"
                    },
                    "pattern": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 512
                    }
                  },
                  "required": [
                    "type",
                    "pattern"
                  ]
                },
                {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "type": {
                      "const": "extension"
                    },
                    "suffix": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 64,
                      "pattern": "^\\.[A-Za-z0-9._-]+$"
                    }
                  },
                  "required": [
                    "type",
                    "suffix"
                  ]
                },
                {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "type": {
                      "const": "content"
                    },
                    "path_glob": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 512
                    },
                    "regex": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 1024
                    },
                    "case_sensitive": {
                      "type": "boolean"
                    }
                  },
                  "required": [
                    "type",
                    "path_glob",
                    "regex"
                  ]
                }
              ]
            },
            "maxItems": 128,
            "minItems": 1,
            "uniqueItems": true
          }
        },
        "required": [
          "technology_id",
          "signals"
        ]
      },
      "maxItems": 1024,
      "minItems": 0,
      "uniqueItems": true
    }
  },
  "required": [
    "schema_version",
    "technologies"
  ]
}
