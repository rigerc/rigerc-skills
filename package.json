{
  "name": "nosey-custom-registry-template",
  "version": "0.1.0-dev.0",
  "private": true,
  "type": "module",
  "engines": {"node": ">=22"},
  "scripts": {
    "build": "node scripts/build.mjs",
    "validate": "node scripts/validate.mjs",
    "check": "node scripts/validate.mjs && node --test tests/*.test.mjs",
    "test": "node --test tests/*.test.mjs",
    "build:manifest": "node scripts/build.mjs --manifest",
    "test:consumer": "node scripts/consumer-smoke.mjs"
  },
  "dependencies": {"ajv":"8.20.0","yaml":"2.9.1","minimatch":"11.0.3"}
}
